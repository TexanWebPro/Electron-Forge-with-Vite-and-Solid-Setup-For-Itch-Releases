{
  "name": "boss-tower-tactical-rush",
  "productName": "Boss Tower Tactical Rush",
  "description": "Boss Tower Tactical Rush, a tactics RPG combat demo by totality.games.",
  "author": {
    "name": "totality.games",
    "email": "moses@totality.games",
    "url": "https://totality.games"
  },
  "private": true,
  "version": "0.0.2-rc.0",
  "type": "module",
  "main": "dist/electron.cjs",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "commit": "cz",
    "prepare": "husky",
    "dev:setup": "vite",
    "dev:start": "vite build && electron .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "build": "tsc -b && vite build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "start": "electron-forge start",
    "prepackage": "pnpm run build",
    "package": "electron-forge package",
    "premake": "pnpm run build",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --targets=@electron-forge/maker-zip",
    "make:linux": "electron-forge make --targets=@electron-forge/maker-deb",
    "make:windows": "electron-forge make --targets=@electron-forge/maker-squirrel",
    "publish": "electron-forge publish",
    "deploy:itch": "pnpm run build && butler push dist mosesintech/boss-tower-tactical-rush:html5 --ignore electron.cjs",
    "preversion": "pnpm check",
    "postversion": "git push --follow-tags",
    "release:rc": "npm version prerelease --preid rc -m \"chore(release): %s\"",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\""
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@excaliburjs/plugin-tiled": "^0.32.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "electron": "^40.0.0",
    "eslint": "^9.39.1",
    "excalibur": "^0.32.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-solid": "^2.11.14"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "types": {
        "feat": {
          "description": "A new feature",
          "title": "Features"
        },
        "fix": {
          "description": "A bug fix",
          "title": "Bug Fixes"
        },
        "docs": {
          "description": "Documentation only changes",
          "title": "Documentation"
        },
        "style": {
          "description": "Changes that do not affect the meaning of the code (white-space, formatting, missing semi-colons, etc)",
          "title": "Styles"
        },
        "refactor": {
          "description": "A code change that neither fixes a bug nor adds a feature",
          "title": "Code Refactoring"
        },
        "test": {
          "description": "Adding missing tests or correcting existing tests",
          "title": "Tests"
        },
        "chore": {
          "description": "Other changes that don't modify src or test files",
          "title": "Chores"
        }
      }
    }
  }
}
